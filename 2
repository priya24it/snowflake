"""Read SQL queries from Excel, run them, and save/display the results."""

from datetime import date, datetime, time
from decimal import Decimal
from pathlib import Path

import pyodbc
from openpyxl import Workbook, load_workbook


# ---------- SETTINGS ----------
SERVER = "TSTDMSQL01"
DATABASE = "STG_HEDIS"
INPUT_FILE = "input_sql_queries.xlsx"
OUTPUT_FILE = "sql_query_results.xlsx"
SQL_FETCH_SIZE = 1000
# ------------------------------


CONNECTION_STRING = (
    "DRIVER={ODBC Driver 17 for SQL Server};"
    f"SERVER={SERVER};"
    f"DATABASE={DATABASE};"
    "Trusted_Connection=yes;"
    "Encrypt=yes;"
    "TrustServerCertificate=yes;"
)


def read_queries():
    """Read Query_Name and SQL_Query columns from the first input sheet."""
    workbook = load_workbook(INPUT_FILE, read_only=True, data_only=True)
    sheet = workbook.active

    headers = {
        str(cell.value).strip(): index
        for index, cell in enumerate(sheet[1])
        if cell.value is not None
    }

    required = {"Query_Name", "SQL_Query"}
    missing = required - set(headers)
    if missing:
        raise ValueError(
            "Input Excel must contain these columns: Query_Name, SQL_Query"
        )

    queries = []
    for row in sheet.iter_rows(min_row=2, values_only=True):
        name = row[headers["Query_Name"]]
        sql = row[headers["SQL_Query"]]
        if name and sql:
            queries.append((str(name).strip(), str(sql).strip()))

    workbook.close()
    return queries


def safe_sheet_name(name, used_names):
    """Create a valid, unique Excel worksheet name."""
    invalid = '[]:*?/\\'
    clean_name = "".join("_" if char in invalid else char for char in name)
    clean_name = clean_name[:31] or "Query"

    candidate = clean_name
    number = 2
    while candidate.lower() in used_names:
        suffix = f"_{number}"
        candidate = clean_name[: 31 - len(suffix)] + suffix
        number += 1

    used_names.add(candidate.lower())
    return candidate


def excel_value(value):
    """Convert uncommon SQL values to values Excel can store."""
    if value is None or isinstance(
        value, (str, int, float, bool, Decimal, date, datetime, time)
    ):
        return value
    if isinstance(value, bytes):
        return value.hex()
    return str(value)


def print_row(values):
    print(" | ".join("NULL" if value is None else str(value) for value in values))


def main():
    if not Path(INPUT_FILE).exists():
        raise FileNotFoundError(
            f"{INPUT_FILE} was not found. Put it in the same folder as this program."
        )

    queries = read_queries()
    if not queries:
        raise ValueError("No SQL queries were found in the input Excel file.")

    output_workbook = Workbook(write_only=True)
    summary_sheet = output_workbook.create_sheet("Summary")
    summary_sheet.append(
        ["Query_Name", "SQL_Query", "Status", "Rows_Returned", "Error_Message"]
    )

    used_sheet_names = {"summary"}

    print(f"Connecting to {SERVER} / {DATABASE} with Windows Authentication...")

    with pyodbc.connect(CONNECTION_STRING, timeout=30) as connection:
        print("Connection successful.\n")

        for query_number, (query_name, sql_query) in enumerate(queries, start=1):
            result_sheet_name = safe_sheet_name(query_name, used_sheet_names)
            result_sheet = output_workbook.create_sheet(result_sheet_name)
            cursor = connection.cursor()

            print("=" * 80)
            print(f"Query {query_number}: {query_name}")
            print(sql_query)
            print("-" * 80)

            try:
                cursor.execute(sql_query)

                if cursor.description is None:
                    affected = cursor.rowcount
                    connection.commit()
                    message = f"Statement completed. Rows affected: {affected}"
                    print(message)
                    result_sheet.append([message])
                    summary_sheet.append(
                        [query_name, sql_query, "SUCCESS", affected, ""]
                    )
                    continue

                columns = [column[0] for column in cursor.description]
                result_sheet.append(columns)
                print_row(columns)

                row_count = 0
                while True:
                    rows = cursor.fetchmany(SQL_FETCH_SIZE)
                    if not rows:
                        break

                    for row in rows:
                        values = list(row)
                        print_row(values)
                        result_sheet.append([excel_value(value) for value in values])
                        row_count += 1

                print(f"Rows returned: {row_count}")
                summary_sheet.append(
                    [query_name, sql_query, "SUCCESS", row_count, ""]
                )

            except Exception as error:
                connection.rollback()
                error_message = str(error)
                print(f"ERROR: {error_message}")
                result_sheet.append(["ERROR", error_message])
                summary_sheet.append(
                    [query_name, sql_query, "FAILED", 0, error_message]
                )
            finally:
                cursor.close()

            print()

    output_workbook.save(OUTPUT_FILE)
    print("=" * 80)
    print(f"Finished. Excel output saved to: {OUTPUT_FILE}")


if __name__ == "__main__":
    main()
